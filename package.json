{
  "name": "open-pledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "lint:unsafe": "biome check . --write --unsafe",
    "format": "biome format --write .",
    "ui:add": "shadcn add",
    "ui:diff": "shadcn add --diff",
    "prepare": "husky",
    "notils": "notils"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.21.0",
    "@solana/web3.js": "^1.98.4",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "snowflake-sdk": "^3.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "@notils/cli": "latest"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
