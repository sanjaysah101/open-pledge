# Every variable this project reads. THE ONLY COMMITTED ENV FILE — documentation
# only, no real values. Copy to .env.local and fill them in there;
# every other .env* file is gitignored.
#
# OpenPledge runs fully in DEMO MODE with none of these set — every integration
# degrades gracefully to a local fallback. Add keys to light up the real thing.
#
# You don't have to edit this file at all: the app also supports BRING-YOUR-OWN-KEY.
# Click "Bring your own key" in the header to paste ElevenLabs/Gemini keys that
# live only in your browser and are sent per-request — ideal for judges testing
# with their own accounts.

NEXT_PUBLIC_APP_NAME="OpenPledge"

# --- Google AI (Gemini) — AI-written thank-you notes & impact summaries ------
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- ElevenLabs — voice receipts (text-to-speech) ----------------------------
# Get a free key at https://elevenlabs.io/app/settings/api-keys
# NOTE: the free tier supports "eleven_multilingual_v2". Turbo models
# (e.g. eleven_turbo_v2_5) can require a paid plan and return HTTP 402.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# --- Solana — transparent on-chain donation ledger (devnet) ------------------
# Optional. Without a treasury key, gifts are recorded as honest "simulated"
# ledger entries. With a funded devnet keypair they become live transactions.
SOLANA_CLUSTER="devnet"
SOLANA_RPC_URL=""
# JSON array of the secret key bytes, e.g. [12,34,...]. Fund it on devnet first.
SOLANA_TREASURY_SECRET=""

# --- Snowflake — transparent aggregate impact analytics ----------------------
# Optional. Without credentials, the Impact dashboard computes the same numbers
# locally. With them, donations mirror to a DONATIONS table and stats read from SQL.
SNOWFLAKE_ACCOUNT=""
SNOWFLAKE_USERNAME=""
SNOWFLAKE_PASSWORD=""
SNOWFLAKE_DATABASE="OPENPLEDGE"
SNOWFLAKE_SCHEMA="PUBLIC"
SNOWFLAKE_WAREHOUSE="COMPUTE_WH"
